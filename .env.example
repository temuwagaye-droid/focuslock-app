# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
# Configure this in the Secrets panel in the AI Studio UI.
SUPABASE_URL=https://vpvbtyaowqydeaynsvwt.supabase.co

# SUPABASE_ANON_KEY: Your Supabase project anon/publishable key.
# Configure this in the Secrets panel in the AI Studio UI.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# GOOGLE_WEB_CLIENT_ID: Google OAuth 2.0 Web Client ID configured in Supabase Auth -> Providers -> Google.
# Configure this in the Secrets panel in the AI Studio UI.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
