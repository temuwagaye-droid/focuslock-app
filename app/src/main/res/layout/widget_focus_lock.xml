<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFEF7FF"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FocusLock Reader"
            android:textColor="#FF1D1B20"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_stats_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0m focus • 0d streak • 0 blocked"
            android:textColor="#FF49454F"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_start_button"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:backgroundTint="#FF6750A4"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="Focus"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
