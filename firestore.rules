rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function immutable(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function validStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidUserProfile(d, userId) {
      return d.keys().hasAll([
          'userId', 'displayName', 'focusScore', 'totalFocusMinutes',
          'completedSessionsCount', 'currentStreak', 'totalBlockedAttempts',
          'treeStage', 'isLeaderboardVisible', 'isPro', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'userId', 'displayName', 'focusScore', 'totalFocusMinutes',
          'completedSessionsCount', 'currentStreak', 'totalBlockedAttempts',
          'treeStage', 'isLeaderboardVisible', 'isPro', 'createdAt', 'updatedAt'
        ])
        && d.userId == userId
        && validStr(d.displayName, 1, 50)
        && d.focusScore is int && d.focusScore >= 0
        && d.totalFocusMinutes is int && d.totalFocusMinutes >= 0
        && d.completedSessionsCount is int && d.completedSessionsCount >= 0
        && d.currentStreak is int && d.currentStreak >= 0
        && d.totalBlockedAttempts is int && d.totalBlockedAttempts >= 0
        && d.treeStage is int && d.treeStage >= 1 && d.treeStage <= 5
        && d.isLeaderboardVisible is bool
        && d.isPro is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidPrivateSettings(d, userId) {
      return d.keys().hasAll(['userId', 'isDarkMode', 'cloudSyncEnabled', 'updatedAt'])
        && d.userId == userId
        && d.isDarkMode is bool
        && d.cloudSyncEnabled is bool
        && d.updatedAt is timestamp
        && (!d.keys().hasAny(['partnerName']) || validStr(d.partnerName, 0, 60))
        && (!d.keys().hasAny(['partnerEmail']) || validStr(d.partnerEmail, 0, 120))
        && (!d.keys().hasAny(['parentalPinHash']) || validStr(d.parentalPinHash, 0, 128))
        && (!d.keys().hasAny(['accentTheme']) || validStr(d.accentTheme, 1, 32));
    }

    function isValidSessionBackup(d, userId, sessionId) {
      return d.keys().hasAll([
          'userId', 'sessionId', 'timestampMs', 'durationSeconds',
          'blockedAttempts', 'isCompleted', 'createdAt'
        ])
        && d.keys().hasOnly([
          'userId', 'sessionId', 'timestampMs', 'durationSeconds',
          'blockedAttempts', 'isCompleted', 'readingAppPackage', 'createdAt'
        ])
        && d.userId == userId
        && d.sessionId == sessionId
        && d.timestampMs is int && d.timestampMs >= 0
        && d.durationSeconds is int && d.durationSeconds >= 0
        && d.blockedAttempts is int && d.blockedAttempts >= 0
        && d.isCompleted is bool
        && (!d.keys().hasAny(['readingAppPackage']) || validStr(d.readingAppPackage, 0, 160))
        && d.createdAt is timestamp;
    }

    function isValidBlockedAppBackup(d, userId) {
      return d.keys().hasAll(['userId', 'packageName', 'appName', 'isBlocked', 'updatedAt'])
        && d.keys().hasOnly(['userId', 'packageName', 'appName', 'isBlocked', 'updatedAt'])
        && d.userId == userId
        && validStr(d.packageName, 1, 160)
        && validStr(d.appName, 1, 100)
        && d.isBlocked is bool
        && d.updatedAt is timestamp;
    }

    function isValidTodoBackup(d, userId, todoId) {
      return d.keys().hasAll(['userId', 'todoId', 'title', 'isCompleted', 'timestampMs', 'updatedAt'])
        && d.keys().hasOnly(['userId', 'todoId', 'title', 'isCompleted', 'timestampMs', 'updatedAt'])
        && d.userId == userId
        && d.todoId == todoId
        && validStr(d.title, 1, 200)
        && d.isCompleted is bool
        && d.timestampMs is int && d.timestampMs >= 0
        && d.updatedAt is timestamp;
    }

    function isValidTelemetry(d, userId) {
      return d.keys().hasAll(['userId', 'kind', 'name', 'detail', 'createdAt'])
        && d.keys().hasOnly(['userId', 'kind', 'name', 'detail', 'createdAt'])
        && d.userId == userId
        && validStr(d.kind, 1, 30)
        && validStr(d.name, 1, 80)
        && validStr(d.detail, 0, 1500)
        && d.createdAt is timestamp;
    }

    function isValidFocusRoom(d, roomId) {
      return d.keys().hasAll([
          'roomId', 'roomCode', 'name', 'hostId', 'hostName',
          'durationMinutes', 'status', 'participantCount', 'isPublic',
          'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'roomId', 'roomCode', 'name', 'hostId', 'hostName',
          'durationMinutes', 'status', 'participantCount', 'isPublic',
          'createdAt', 'updatedAt'
        ])
        && d.roomId == roomId
        && validStr(d.roomCode, 4, 12)
        && validStr(d.name, 1, 60)
        && validStr(d.hostId, 1, 128)
        && validStr(d.hostName, 1, 50)
        && d.durationMinutes is int && d.durationMinutes >= 5 && d.durationMinutes <= 180
        && d.status in ['waiting', 'active', 'completed']
        && d.participantCount is int && d.participantCount >= 0 && d.participantCount <= 50
        && d.isPublic is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidParticipant(d, participantId) {
      return d.keys().hasAll([
          'userId', 'displayName', 'status', 'distractionAttempts',
          'treeStage', 'joinedAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'userId', 'displayName', 'status', 'distractionAttempts',
          'treeStage', 'joinedAt', 'updatedAt'
        ])
        && d.userId == participantId
        && validStr(d.displayName, 1, 50)
        && d.status in ['ready', 'focusing', 'completed', 'left']
        && d.distractionAttempts is int && d.distractionAttempts >= 0
        && d.treeStage is int && d.treeStage >= 1 && d.treeStage <= 5
        && d.joinedAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || resource.data.isLeaderboardVisible == true);
      allow list: if isSignedIn() && (resource.data.isLeaderboardVisible == true || isOwner(userId));
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId)
        && isValidUserProfile(request.resource.data, userId)
        && immutable('userId')
        && immutable('createdAt');
      allow delete: if isOwner(userId);

      match /private/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && (docId != 'settings' || isValidPrivateSettings(request.resource.data, userId));
        allow update: if isOwner(userId)
          && (docId != 'settings' || isValidPrivateSettings(request.resource.data, userId))
          && (!resource.data.keys().hasAny(['userId']) || immutable('userId'));
        allow delete: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSessionBackup(request.resource.data, userId, sessionId);
        allow update: if isOwner(userId)
          && isValidSessionBackup(request.resource.data, userId, sessionId)
          && immutable('userId')
          && immutable('sessionId')
          && immutable('createdAt');
        allow delete: if isOwner(userId);
      }

      match /blockedApps/{appId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBlockedAppBackup(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidBlockedAppBackup(request.resource.data, userId)
          && immutable('userId')
          && immutable('packageName');
        allow delete: if isOwner(userId);
      }

      match /todos/{todoId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTodoBackup(request.resource.data, userId, todoId);
        allow update: if isOwner(userId)
          && isValidTodoBackup(request.resource.data, userId, todoId)
          && immutable('userId')
          && immutable('todoId');
        allow delete: if isOwner(userId);
      }

      match /analytics/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTelemetry(request.resource.data, userId);
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /crashReports/{reportId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTelemetry(request.resource.data, userId);
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    match /focusRooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && isValidFocusRoom(request.resource.data, roomId);
      allow update: if isSignedIn()
        && isValidFocusRoom(request.resource.data, roomId)
        && immutable('roomId')
        && immutable('hostId')
        && immutable('createdAt')
        && (
          resource.data.hostId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount', 'updatedAt'])
        );
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      match /participants/{participantId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && participantId == request.auth.uid
          && isValidParticipant(request.resource.data, participantId);
        allow update: if isSignedIn()
          && participantId == request.auth.uid
          && isValidParticipant(request.resource.data, participantId)
          && immutable('userId')
          && immutable('joinedAt');
        allow delete: if isSignedIn()
          && (
            participantId == request.auth.uid ||
            get(/databases/$(database)/documents/focusRooms/$(roomId)).data.hostId == request.auth.uid
          );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
